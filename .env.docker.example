# The environment the containers run in.
#
# Copy this to .env.docker and fill in the blanks. That file is gitignored:
# it holds the same mail password and Google client secret as .env, so it
# must never reach the repository.
#
#     cp .env.docker.example .env.docker
#
# This is NOT the .env XAMPP reads. The two run side by side -- different
# port, different database, different file -- so starting the containers
# leaves the local setup alone.

APP_NAME="CSPC Student Concern Reporting System"
APP_ENV=production
APP_DEBUG=false

# Generate once and keep it. A key that changes between restarts logs
# everybody out and makes anything encrypted unreadable:
#     php artisan key:generate --show
APP_KEY=

# What the browser types. The container listens on 80 and compose maps it
# to 8002, so 8001 stays free for `php artisan serve` on this machine.
APP_URL=http://localhost:8002

# Where links in emails point. On the deployed host this is the public
# address; locally it is the same as APP_URL.
APP_PUBLIC_URL=http://localhost:8002

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Manila

# ---------------------------------------------------------------- database
# DB_HOST is the service name from docker-compose.yml, not 127.0.0.1: inside
# the network the database answers to "db", and localhost is the application
# container itself.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cspcconcern
DB_USERNAME=cspcconcern
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ----------------------------------------------------------------- drivers
# All on the database, which is why there is no Redis container: sessions,
# cache and the queue are small here and a third service would be one more
# thing to run for no gain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# -------------------------------------------------------------------- mail
# Notification email. Copy these from your own .env.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="CSPC Report Concern"

# ------------------------------------------------------------ google oauth
# The only way in. The redirect URI must also be listed in the Google Cloud
# console for the sign-in to work -- add http://localhost:8002/auth/google/callback
# there before trying it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------- flags
# The demo sign-in is refused in production whatever this says; it is here
# so the value is not a surprise.
DEMO_LOGIN_ENABLED=false

# Set false to start the container without applying migrations.
RUN_MIGRATIONS=true
